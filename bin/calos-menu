#!/bin/bash

export PATH="$HOME/.local/share/calos/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=true

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | calos-launch-walker --dmenu -N -H --minwidth 225 --minheight 1 --maxheight 600 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  $TERMINAL --class Calos -e "$@"
}

edit_in_nvim() {
  notify-send "Editing fastfetch logo configuration in Neovim" "$1"
  $TERMINAL --class Calos -e nvim "$1"
}

show_style_menu() {
  case $(menu "Style" "󰸌  Theme\n  Font\n  Background\n󱄄  Fastfetch") in
  *Theme*) qs -c theme ;;
  *Font*) show_font_menu ;;
  *Background*) quickshell -c wallselect ;;
  *Fastfetch*) edit_in_nvim ~/.config/calos/branding/fastfetch.txt ;;
  *) show_main_menu ;;
  esac
}

show_theme_menu() {
  walker -H -N -n -m menus:calosthemes --minwidth 200 --minheight 400
}

show_font_menu() {
  font=$(menu "Font" "$(calos-font-list)" "--width 350" "$(calos-font-current)")

  if [[ "$font" == "CNCLD" || -z "$font" ]]; then
    back_to show_style_menu
  else
    calos-font-set "$font"
  fi
}

show_capture_menu() {
  case $(menu "Capture" "  Screenshot\n  Screenrecord\n󰃉  Color") in
  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *Color*) pkill hyprpicker || hyprpicker -a ;;
  *) show_main_menu ;;
  esac
}

show_screenshot_menu() {
  case $(menu "Screenshot" "  Region\n  Window\n  Display") in
  *Region*) hyprshot -m region --freeze ;;
  *Window*) hyprshot -m window ;;
  *Display*) hyprshot -m output ;;
  *) show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  case $(menu "Screenrecord" "  Region\n  Display") in
  *Region*) calos-cmd-screenrecord ;;
  *Display*) calos-cmd-screenrecord output ;;
  *) show_capture_menu ;;
  esac
}

show_toggle_menu() {
  case $(menu "Toggle" "󱄄  Screensaver\n󰔎  Hyprsunset\n󰍜  Waybar\n󰺷  Game Mode\n  Big Picture\n󰍹  Display Swap\n󱥂  Notifications") in
  *Hyprsunset*) calos-toggle-nightlight ;;
  *Display*) calos-toggle-output ;;
  *Screensaver*) calos-launch-screensaver ;;
  *Waybar*) calos-toggle-waybar ;;
  *Big*) calos-toggle-bigpic ;;
  *Game*) calos-toggle-gamemode ;;
  *Notifications*) calos-toggle-notifications ;;
  *) show_main_menu ;;
  esac
}

show_update_process_menu() {
  case $(menu "Reload" "  Hypridle\n󰔎  Hyprsunset\n  Awww Daemon\n󱄄  SwayOSD\n  Overview\n󰌧  Walker\n󰍜  Waybar") in
  *Hypridle*) calos-restart-hypridle ;;
  *Hyprsunset*) calos-restart-hyprsunset ;;
  *Awww*) calos-restart-awww ;;
  *SwayOSD*) calos-restart-swayosd ;;
  *Walker*) calos-restart-walker ;;
  *Waybar*) calos-restart-waybar ;;
  *Overview) calos-restart-overview ;;
  *) show_main_menu ;;
  esac
}

show_system_menu() {
  case $(menu "System" "  Clipboard\n  Packages\n󰚰  Update\n󰗽  BIOS Reboot\n󰜉  Logout\n󰐥  Shutdown") in
  *Packages*) alacritty --class packages -e calos-pkg-list ;;
  *Update*) alacritty --class=System-Update -e calos-cmd-update ;;
  *Clipboard*) alacritty --class clipse -e clipse ;;
  *Logout*) calos-logoff ;;
  *Shutdown*) calos-shutdown ;;
  *BIOS*) calos-bios-reboot ;;
  *) show_main_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Settings" "󰙵  Programs\n  Style\n  Capture\n󰨙  Toggle\n  Reload\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *programs*) walker -p "Launch..." ;;
  *style*) show_style_menu ;;
  *theme*) show_theme_menu ;;
  *reload*) show_update_process_menu ;;
  *capture*) show_capture_menu ;;
  *toggle*) show_toggle_menu ;;
  *system*) show_system_menu ;;
  esac
}

toggle_existing_menu

if [[ -n "$1" ]]; then
  go_to_menu "$1"
else
  show_main_menu
fi
