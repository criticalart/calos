#!/bin/bash

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
if pgrep -f "$TERMINAL.*Screensaver" &>/dev/null; then
  exit 0
fi

# Allow screensaver to be turned off but also force started
#if [[ -f ~/.local/state/calos/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
#  exit 1
#fi

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command="$1"

  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"
  hypr_exec "alacritty --class=Screensaver --config-file ~/.config/alacritty/screensaver.toml -e calos-cmd-screensaver"

done

hypr_focus_monitor "$focused"
