#!/bin/bash

if [[ $(hyprctl submap) == gaming ]]; then
  hyprctl dispatch 'hl.dsp.submap("reset")'
  notify-send '󰊵 Game Mode Disabled' 'SUPER Key functionality has been restored.'
else
  hyprctl dispatch 'hl.dsp.submap("gaming")'
  notify-send '󰊴 Game Mode Enabled - SUPER Key Limited' 'Use CTRL + SUPER + G to toggle game mode on/off.\nSUPER + CTRL + Q now closes the active window.'
fi

pkill -RTMIN+10 waybar
