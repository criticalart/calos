#!/bin/bash

if [[ -z "$1" && "$1" != "CNCLD" ]]; then
  echo "Usage: calos-theme-set <theme-name>" >&2
  exit 1
fi

THEMES_DIR="$HOME/.config/calos/themes/"
CURRENT_THEME_DIR="$HOME/.config/calos/current/theme"
VESKTOP_THEME="$HOME/.config/vesktop/themes/calos.theme.css"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR" >&2
  exit 2
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"
ln -nsf "$THEME_PATH/vesktop.css" "$VESKTOP_THEME"

# Change background with theme
hyprctl reload
calos-theme-bg-next
touch "$HOME/.config/alacritty/alacritty.toml"
pkill -SIGUSR2 btop
pkill -SIGUSR1 cava
makoctl reload
qs -c calos-shell ipc call osd refreshTheme
qs -c calos-shell ipc call overview refreshTheme
pkill -SIGUSR2 waybar
