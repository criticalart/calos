#!/bin/bash

pactl load-module module-null-sink sink_name=cmus_audio sink_properties=device.description=CMUS_Audio
pactl load-module module-loopback source=cmus_audio.monitor
sleep 1.5
notify-send -t 1750 "  Welcome to -caliburnOS-!" 'Initializing...'
sleep 1
hyprctl -q hyprsunset temperature 6600
pamixer --set-volume 80
awww img ~/.config/calos/current/background --resize stretch --transition-type wipe --transition-angle 150 --transition-fps 144 --transition-duration 2.4
pkill -SIGUSR2 waybar
sleep 0.1
sed -i -E 's/^.*("start_hidden": true,)/  \/\/ \1/' ~/.config/waybar/config.jsonc
sleep 0.1
ffplay -autoexit -nodisp -volume 60 ~/.config/calos/branding/start.mp3 &
sleep 0.8
pkill -SIGUSR1 waybar
