#!/bin/bash

calos-cmd-close-all-windows
playerctl pause
sleep 0.1
awww img ~/.config/calos/branding/off.png --resize stretch --transition-type wipe --transition-angle=90 --transition-fps 144 --transition-duration 1
sleep 0.4
pkill -SIGUSR1 waybar
awww clear-cache
sed -i -E 's/^.*("start_hidden": true,)/  \1/' ~/.config/waybar/config.jsonc
ffplay -autoexit -nodisp -volume 20 ~/.config/calos/branding/shutdown.mp3
systemctl reboot --firmware-setup
