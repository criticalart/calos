#!/bin/bash

set -o pipefail

PREVIEW_LINES=80
SCRIPT_PATH="$HOME/.local/share/calos/bin/calos-cmd-search"

for cmd in plocate fzf bat file xdg-open nvim yazi gum alacritty pqiv ffplay setsid perl; do
  if ! command -v "$cmd" &>/dev/null; then
    printf 'Error: %s is not installed.\n' "$cmd" >&2
    exit 1
  fi
done

preview_file() {
  local target="$1"
  local file_info

  if [[ -z "$target" ]]; then
    return
  fi

  if [[ -d "$target" ]]; then
    printf '\033[1;36mDirectory\033[0m\n\n'
    ls -lah -- "$target"
    return
  fi

  if [[ ! -e "$target" ]]; then
    printf '\033[1;31mFile no longer exists.\033[0m\n'
    return
  fi

  file_info="$(file --brief -- "$target")"

  printf '\033[1;36m%s\033[0m\n\n' "$file_info"

  case "$file_info" in
  *text* | *Text* | *JSON\ data* | *XML\ document* | *shell\ script*)
    bat \
      --style=numbers \
      --color=always \
      --line-range=":${PREVIEW_LINES}" \
      -- "$target"
    ;;

  *image\ data* | *JPEG* | *PNG* | *GIF*)
    printf '\033[1;33mImage file\033[0m\n'
    printf '\n%s\n' "$target"
    ;;

  *)
    printf '\033[1;33mBinary / non-text file\033[0m\n'
    ;;
  esac
}

build_search_regex() {
  perl -CS -Mutf8 -e '
    my $s = shift;

    my %map = (
      a => "[aàáâãäåāăąǎȧạảấầẩẫậắằẳẵặ]",
      c => "[cçćĉċč]",
      d => "[dďđ]",
      e => "[eèéêëēĕėęěẹẻẽếềểễệ]",
      g => "[gĝğġģ]",
      h => "[hĥħ]",
      i => "[iìíîïĩīĭįıǐịỉ]",
      j => "[jĵ]",
      k => "[kķ]",
      l => "[lĺļľł]",
      n => "[nñńņňŋ]",
      o => "[oòóôõöøōŏőơǒọỏốồổỗộớờởỡợ]",
      r => "[rŕŗř]",
      s => "[sśŝşšș]",
      t => "[tťţŧț]",
      u => "[uùúûüũūŭůűųưǔụủứừửữự]",
      w => "[wŵ]",
      y => "[yýÿŷỳỵỷỹ]",
      z => "[zźżž]"
    );

    my $regex = "";

    while ($s =~ /(.|$)/g) {
      my $c = $1;

      last if $c eq "";

      my $lc = lc($c);

      if (exists $map{$lc}) {
        $regex .= $map{$lc};
      } else {
        $c =~ s/([\\.^$|(){}\[\]*+?])/\\$1/g;
        $regex .= $c;
      }
    }

    print $regex;
  ' -- "$1"
}

search_files() {
  local query="$1"
  local regex

  regex="$(build_search_regex "$query")"

  plocate \
    --ignore-case \
    --regexp \
    -- "$regex"
}

export -f preview_file
export -f build_search_regex
export -f search_files
export PREVIEW_LINES

if [[ "$1" != "--fzf" ]]; then

  gum style \
    --foreground=2 \
    --padding="1 1" \
    --margin="1 0 0 0" \
    --align=left \
    '                     FILE SEARCH'

  gum style \
    --padding="0 1" \
    --margin="0 0 2 0" \
    --align=left \
    ' Search files across your system using fzf and plocate.'

  search_term="$(
    gum input \
      --prompt='            Search: ' \
      --prompt.foreground=2 \
      --cursor.foreground=4 \
      --placeholder='enter a filename or path' \
      --width=60 \
      --show-help=false
  )"

  if [[ -z "$search_term" ]]; then
    exit 0
  fi

  setsid -f \
    alacritty \
    --class file-search \
    -e "$SCRIPT_PATH" --fzf "$search_term" \
    >/dev/null 2>&1

  exit 0
fi

shift

search_term="$*"

if [[ -z "$search_term" ]]; then
  exit 0
fi

selected="$(
  search_files "$search_term" |
    fzf \
      --ansi \
      --border=rounded \
      --layout=reverse \
      --highlight-line \
      --height=100% \
      --delimiter='/' \
      --freeze-right=1 \
      --prompt='Filter: ' \
      --border-label=' Database Search ' \
      --marker='✓' \
      --preview-label=' File Preview ' \
      --preview-label-pos='bottom' \
      --no-multi \
      --preview='bash -c '\''preview_file "$1"'\'' _ {}' \
      --preview-window='bottom:55%:wrap' \
      --bind 'ctrl-p:toggle-preview' \
      --bind 'ctrl-r:reload(bash -c '\''search_files "$1"'\'' _ {q})' \
      --bind 'ctrl-k:preview-up,ctrl-j:preview-down' \
      --header='       CTRL-R: refresh search • CTRL-P: toggle preview • ENTER: open • ESC: quit' \
      --header-first
)"

[[ -z "$selected" ]] && exit 0

if [[ -d "$selected" ]]; then
  alacritty --class yazi-float -e yazi -- "$selected"
  exit 0
fi

if [[ ! -e "$selected" ]]; then
  printf 'File no longer exists:\n%s\n' "$selected"
  exit 1
fi

mime_type="$(file --mime-type -Lb -- "$selected")"

case "$mime_type" in
text/*)
  nvim -- "$selected"
  ;;

image/jpeg | image/png | image/gif)
  pqiv -- "$selected"
  ;;

audio/*)
  ffplay -- "$selected"
  ;;

*)
  xdg-open "$selected" &>/dev/null &
  ;;
esac
