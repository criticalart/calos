#!/bin/bash

GRN='\033[1;32m'
CYN='\033[1;36m'
YLW='\033[1;33m'
RED='\033[1;31m'
DIM='\033[2m'
RST='\033[0m'

fzf_args=(
  --multi
  --preview 'pacman -Sii {1}'
  --preview-label=' Package Information '
  --preview-label-pos='bottom'
  --preview-window='down:55%:wrap'

  --bind 'ctrl-p:toggle-preview'
  --bind 'ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up'
  --bind 'ctrl-k:preview-up,ctrl-j:preview-down'
  --bind 'space:toggle'

  --color='pointer:green,marker:green'
  --layout=reverse
  --highlight-line

  --border
  --border-label=' Package Installer '
  --prompt='➜ '
  --marker='✓'

  --header=' SPACE: select • CTRL-P: preview • CTRL-J/K: scroll • ENTER: install'
  --header-first
)

while true; do

  pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")

  if [[ -z "$pkg_names" ]]; then
    clear
    printf '%bNo packages selected.%b\n' "$DIM" "$RST"
    exit 0
  fi

  mapfile -t packages <<<"$pkg_names"

  clear

  printf '%bInstalling the following package(s):%b\n\n' "$CYN" "$RST"

  for pkg in "${packages[@]}"; do
    printf '  %b✓%b %s\n' "$GRN" "$RST" "$pkg"
  done

  printf '\n'

  choice=$(
    gum choose \
      --header="Proceed?" \
      --cursor.foreground="2" \
      --selected.foreground="7" \
      --selected.background="4" \
      --header.foreground="6" \
      "Yes" \
      "No" \
      "Exit"
  )

  case "$choice" in
  Yes)
    break
    ;;

  No)
    clear
    continue
    ;;

  Exit | "")
    clear
    printf '%bExiting.%b\n' "$DIM" "$RST"
    exit 0
    ;;
  esac

done

printf '\n'

if sudo pacman -S --noconfirm "${packages[@]}"; then

  clear

  printf '%b✓ Installation complete%b\n\n' "$GRN" "$RST"

  printf '%bInstalled:%b\n\n' "$CYN" "$RST"

  for pkg in "${packages[@]}"; do
    printf '  %b✓%b %s\n' "$GRN" "$RST" "$pkg"
  done

  printf '\n%bPress any key to exit...%b' "$DIM" "$RST"
  read -r -n 1 -s
  printf '\n'

else

  printf '\n%b✗ Installation failed.%b\n' "$RED" "$RST"
  printf '%bSome packages may not have been installed.%b\n' "$YLW" "$RST"

  printf '\n%bPress any key to exit...%b' "$DIM" "$RST"
  read -r -n 1 -s
  printf '\n'

  exit 1
fi
