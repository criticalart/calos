{
	/*------------
		layout
	------------*/

	"modules-left": [
		"group/main_menu",
  //  "custom/left_div#2",
		"hyprland/workspaces",
	//	"custom/right_div#5",
		"hyprland/window"
	],
	"modules-center": [
		"custom/left_div#2",
		"temperature",
		"custom/left_div#3",
		"memory",
		"custom/left_div#4",
		"cpu",
		"custom/left_inv#1",
		"custom/left_div#5",
		"custom/distro",
		"custom/right_div#2",
		"custom/right_inv#1",
		"clock#time",
		"custom/right_div#3",
		"clock#date",
		"custom/right_div#4",
		"disk",
		"custom/right_div#5"
	],
	"modules-right": [
		"mpris",
    "cava",
   // "custom/space",
		"custom/left_div#2",
    "pulseaudio",
    "hyprland/submap",
    "custom/screenrecording-indicator",
    "network",
		"bluetooth",
		"custom/system_update",
    "custom/right_div#5",
		"group/hypr_switcher"
	],

	/*-------------
		options
	-------------*/

"tray": {
    "icon-size": 18,
    "spacing": 11,
    "icons": {

    }
},

	"layer": "bottom",
	// "output":
	// "position":
	"height": 0,
	"width": 0,
	"margin": 0,
	"margin-top": 4,
	"margin-left": 4,
	// "margin-bottom":
	"margin-right": 4,
	"spacing": 0,
	// "name":
	"mode": "dock",
	// "start_hidden":
	// "modifier-reset":
	// "exclusive":
	// "fixed-center":
	// "passthrough":
	// "ipc":
	// "id":
	"reload_style_on_change": true,

	/*-------------
		modules
	-------------*/


  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "alacritty --class=Bluetui -e bluetui"
  },

	"clock#time": {
		// "interval":
		"format": " {:%H:%M}",
		// "timezone":
		// "timezones":
		// "locale":
		"min-length": 7,
		"max-length": 7,
		// "rotate": 0,
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "{:%I:%M %p}"
	},

	/*--------------
		calendar
	--------------*/

	"clock#date": {
		// "interval":
		"format": "󰸗 {:%m-%d}",
		// "timezone":
		// "timezones":
		// "locale":
		"min-length": 8,
		"max-length": 8,
		// "rotate":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "{calendar}",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 6,
			// "week-pos":
			// "on-scroll":
			"format": {
				"months": "<span alpha='100%'><b>{}</b></span>",
				"days": "<span alpha='90%'>{}</span>",
				// "weeks":
				"weekdays": "<span alpha='80%'><i>{}</i></span>",
				"today": "<span alpha='100%'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click": "mode"
			// "on-click-middle":
			// "on-click-right":
			// "on-scroll-up":
			// "on-scroll-down":
		}
	},

	"cpu": {
		"interval": 3,
		"format": "󰍛 {usage}%",
		"format-warning": "󰀨 {usage}%",
		"format-critical": "󰀨 {usage}%",
		"min-length": 7,
		"max-length": 7,
		// "rotate":
		"states": {
			"warning": 75,
			"critical": 90
		},
		// "on-click": "alacritty --class=Impala -e btop -p 2",
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		"tooltip": false
	},

  "disk": {
    "interval": 600,
    "format": " {free}",
    "path": "/",
    "tooltip": true,
    "max-length": 10,
    "min-length": 10,
    "on-click": "alacritty --class=Impala --hold -e sudo dust 2> /dev/null",
    "tooltip-format": "{used} out of {total} used."
},

	"memory": {
		"interval": 5,
		"format": "󰘚 {used:0.1f}GB",
		"format-warning": "󰀧 {percentage}%",
		"format-critical": "󰀧 {percentage}%",
		// "rotate":
		"states": {
			"warning": 75,
			"critical": 90
		},
		"min-length": 9,
		"max-length": 9,
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		"tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB"
	},

	"mpris": {
		// "player":
		// "ignored-players":
		// "interval":
		"format": "{player_icon} {title} - {artist}",
		"format-paused": "{status_icon} {title} - {artist}",
    "tooltip": false,
		"tooltip-format": "Playing: {title} - {artist}",
		"tooltip-format-paused": "Paused: {title} - {artist}",
		// "enable-tooltip-len-limits":
		// "on-click":
		// "on-click-middle":
		// "on-click-right":
		"player-icons": {
			"default": "󰐊"
		},
		"status-icons": {
			"paused": "󰏤"
		},
		// "dynamic-order":
		// "dynamic-len":
		// "dynamic-separator":
		// "dynamic-importance-order":
		// "min-length":
		"max-length": 85
	},

"cava": {
        //"cava_config": "$XDG_CONFIG_HOME/calos/current/theme/cava/config",
        "framerate": 60,
        "autosens": 0,
        "sensitivity": 1,
        "bars": 14,
        "min-length": 1,
        "max-length": 14,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": false,
        "sleep_timer": 2,
        "format_silent": "             ",
        "method": "pipewire",
        "source": "auto",
        "data_format": "ascii",
        "stereo": true,
        "reverse": true,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.55,
        "input_delay": 2,
        "format-icons": [ " ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "on-click": "playerctl play-pause"
    },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 10,
    "spacing": 1,
    "on-click": "alacritty --class=Impala -e impala"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "on-click": "alacritty --class=Wiremix -e wiremix",
    "on-click-right": "pamixer -t",
    "tooltip": false,
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

	  "temperature": {
    //"thermal-zone": 1,
   "interval": "4",
   "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
   "critical-threshold": 70,
   "format-critical": "  {temperatureC}°C",
   "format": "  {temperatureC}°C ",
   "format-icons": ["", "", ""],
   "max-length": 10,
   "min-length": 10,
   "tooltip": false 
  },

	"hyprland/window": {
		"format": "{class}",
		"rewrite": {
			"^$": "󰍹  Desktop",
			// "^Alacritty$": "btop++",
      "com.github.PintaProject.Pinta": "  Pinta Image Editor",
			"cava": "  CAVA Audio Visualizer",
      "Alacritty": "  Alacritty",
			"firefox": "󰈹  Mozilla Firefox",
			"btop": "  BTOP++ System Information",
      "yazi": "  Yazi",
      "System-Update": "󰚰  System Update",
      "About": "󰖷  System Information",
      "arthur@caliburn": "  arthur@caliburn",
      "Neovim": "  Neovim",
      "ffplay": "󰯜  FFmpeg",
      "pqiv": "  pqiv",
      "cmus": "󰝚  cmus Music Player",
      "vesktop": "  Discord",
      "steam": "  Steam",
      "Bluetui": "󰂯  Bluetui",
      "Impala": "󰖩  Impala",
      "Wiremix": "󱡬  Wiremix",
      "clipse": "  Clipse",
      "FFPWA-01K961PSAZSCYS2324FFDRTC7Q": "Apple Music",
      "FFPWA-01K965RT5B50H7XFYV0EAQN4B8": "󰣇  ArchLinux Wiki",
      "FFPWA-01KAC9901ABNXA5Q8EHX1KRDFV": "HBO Max",
      "FFPWA-01K966XKVA9QGPGYZB5K84ZBR8": "  Hyprland Wiki"
		},
		// "separate-outputs":
		"icon": false,
		// "icon-size":
		// "min-length":
		// "max-length":
		"tooltip": false,
		"swap-icon-label": false
	},

	"hyprland/windowcount": {
		"format": "[{}]",
		// "format-empty":
		// "format-windowed":
		// "format-fullscreen":
		// "separate-outputs":
		// "min-length":
		// "max-length":
		"swap-icon-label": false
	},

	"hyprland/workspaces": {
		// "active-only":
		// "hide-active":
		// "all-outputs":
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
		"format": "{icon}",
		"format-icons": {
    //  "2": "\ue795",
     // "3": "\uf1b6",
		  "active": "",
			"default": ""
		},
		"persistent-workspaces": {
			"*": 5
		},
		// "persistent-only":
		// "show-special":
		// "special-visible-only":
		// "sort-by":
		// "window-rewrite":
		// "window-rewrite-default":
		// "format-window-separator":
		// "move-to-monitor":
		// "ignore-workspaces":
		// "on-scroll-up":
		// "on-scroll-down":
		"cursor": true
	},

"hyprland/submap": {
	"format": "󰊴",
  "min-length": 2,
	"max-length": 2,
  "justify": "center",
  "on-click": "~/.config/waybar/scripts/submap.sh",
  "tooltip": true,
	"tooltip-format": "SUPER + CTRL + G to disable"
},

	"group/main_menu": {
		"orientation": "horizontal",
		"modules": [
			"custom/menu_open",
			"custom/user"
		],
		"drawer": {
			// "transition-duration":
			// "transition-left-to-right":
			// "children-class":
			// "click-to-reveal":
		}
	},

	"custom/menu_open": {

		"format": ">",
		// "format-icons":
		// "rotate":
		"min-length": 4,
		"max-length": 4,
		"on-click": "calos-menu",
		"tooltip": false,	},

	"custom/user": {
		"exec": "id --user --name",
		"format": "{}",
		"on-click": "calos-menu",
		"tooltip": false
	},

	"custom/distro": {
		"format": "󰣇",
    "on-click": "calos-walker-app",
		"tooltip": false
	},

	/*-------------------
		left dividers
	-------------------*/

	"custom/left_div#1": {
		"format": "",
		"tooltip": false
	},	
  "custom/space": {
		"format": "  ",
		"tooltip": false
	},
	"custom/left_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#5": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#6": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#7": {
		"format": "",
		"tooltip": false
	},
	"custom/left_div#8": {
		"format": "",
		"tooltip": false
	},
	"custom/left_inv#1": {
		"format": "",
		"tooltip": false
	},
	"custom/left_inv#2": {
		"format": "",
		"tooltip": false
	},

	/*--------------------
		right dividers
	--------------------*/

	"custom/right_div#1": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#2": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#3": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#4": {
		"format": "",
		"tooltip": false
	},
	"custom/right_div#5": {
		"format": "",
		"tooltip": false
	},
	"custom/right_inv#1": {
		"format": "",
		"tooltip": false
	},

	"group/hypr_switcher": {
		"orientation": "horizontal",
		"modules": [
			"custom/hypr_menu",
			"custom/version"
		],
		"drawer": {
			// "transition-duration":
			"transition-left-to-right": false,
			// "children-class":
			// "click-to-reveal":
		}
	},

	"custom/hypr_menu": {
		"format": "\uf359",
	"on-click": "alacritty --class=About -e ~/.config/waybar/scripts/sysinfo.sh",
		"tooltip": false,
    "min-length": 2,
		"max-length": 2
	},

  	"custom/version": {
		"exec": "pacman -Qe hyprland",
		"format": " {}",
		"on-click": "alacritty --class=About -e ~/.config/waybar/scripts/sysinfo.sh",
		"tooltip": false
	},

    "custom/screenrecording-indicator": {
    "on-click": "calos-cmd-screenrecord",
    "exec": "~/.config/waybar/scripts/screen-recording.sh",
    "signal": 8,
    "min-length": 3,
    "max-length": 3,
   "return-type": "json"
  },

	"custom/system_update": {
		"exec": "~/.config/waybar/scripts/system-update.sh",
		// "exec-if":
		// "exec-on-event":
		// "hide-empty-text":
		"return-type": "json",
		"interval": 7200,
		// "restart-interval":
		// "signal":
		"format": "{}",
		// "format-icons":
		// "rotate":
		"min-length": 2,
		"max-length": 2,
		"on-click": "alacritty --class=System-Update -e ~/.config/waybar/scripts/system-update.sh start"
		// "on-click-middle":
		// "on-click-right":
		// "on-scroll-up":
		// "on-scroll-down":
		// "smooth-scrolling-threshold":
		// "tooltip":
		// "tooltip-format":
		// "escape":
	}
}
