{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/calos/branding/fastfetch.txt",
    "padding": {
      "top": 2,
      "right": 5,
      "left": 4
    },
        "color": {
        "1": "blue",
        },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────Hardware──────────────────┐"
    },
    {
      "type": "command",
      "key": "│ ┌ ",
      "keyColor": "green",
      "text": "echo GIGABYTE X870 AORUS Stealth ICE"
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ ├ ",
      "detectionMethod": "pci",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄 ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊 ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "└ └ ",
      "keyColor": "green"
    },
//    {
//      "type": "swap",
//      "key": "└ └󰓡 ",
//      "keyColor": "green"
//    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌─────────────────Software──────────────────┐"
    },
    {
      "type": "command",
      "key": "│ ┌󰣇 ",
      "keyColor": "blue",
      "text": "echo 'caliburnOS v0.8.7 (Arch)'",
    },
    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": " DE ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "│ ├ ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼 ",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├󰸌 ",
      "keyColor": "blue",
      "text": "theme=$(calos-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "command",
      "key": "└ └ ",
      "keyColor": "blue",
      "text": "font=$(calos-font-current); echo -e $font"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────OS Age / Update──────────────┐"
    },
    {
      "type": "command",
      "key": "│ Install Age ",
      "keyColor": "magenta",
      "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days ago\"",
    },
    {
      "type": "command",
      "key": "│ Last Update ",
      "text": "last=$(grep -E 'starting full system upgrade' /var/log/pacman.log | tail -n1 | cut -d'[' -f2 | cut -d']' -f1); if [ -n \"$last\" ]; then date -d \"$last\" '+%Y-%m-%d %H:%M'; else echo 'Unknown'; fi",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────┘"
    },
    "break"
  ]
}
