export CALOS_PATH=$HOME/.local/share/calos
export PATH=$CALOS_PATH/bin/:$PATH
export TERMINAL=alacritty

export CARGO_HOME=$HOME/.local/cargo
export GOPATH=$HOME/.local/go
export GOMODCACHE=$HOME/.local/go/mod
export RUSTUP_HOME=$HOME/.local/rustup
export WINEPREFIX=$HOME/.local/wine
export CUDA_CACHE_PATH="$HOME/.local/nv"

export XCURSOR_SIZE=28
export XCURSOR_THEME=BreezeX-Black
export GDK_BACKEND=wayland,x11,*

export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=qt6ct

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
